# ==============================================================================
# Vyranux - Çevre Değişkenleri (Environment Variables)
# ==============================================================================
# Vercel Deployment:
# Bu değişkenleri Vercel Proje Paneli -> Settings -> Environment Variables
# kısmından tanımlayabilirsiniz.
# ==============================================================================

# GEMINI_API_KEY: Gemini AI API çağrıları için opsiyonel anahtar.
# Boş bırakılırsa Vyranux dahili spor bilimcisi ve kural tabanlı motoruyla
# hiçbir hata vermeden, %100 yerel ve ücretsiz olarak çalışmaya devam eder.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Uygulamanın barındırıldığı URL (Örn: https://vyranux.vercel.app).
APP_URL="MY_APP_URL"

